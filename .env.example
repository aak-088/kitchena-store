SUPABASE_SECURITY_TEST_ADMIN_PASSWORD=""
SUPABASE_SECURITY_TEST_USER_EMAIL=""
SUPABASE_SECURITY_TEST_USER_PASSWORD=""
SUPABASE_SECURITY_TEST_APP_URL="http://localhost:3000"
